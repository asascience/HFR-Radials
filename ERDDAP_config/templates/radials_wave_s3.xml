            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">swell_wave_vector_flag</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>SWBD</sourceName>
        <destinationName>SWBD</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
