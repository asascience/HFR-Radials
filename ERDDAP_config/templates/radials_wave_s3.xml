<dataset type="EDDTableFromAsciiFiles" datasetID="#INSTITUTION#_#STATION#_hfr_wave" active="true">
    <reloadEveryNMinutes>10080</reloadEveryNMinutes>
    <updateEveryNMillis>-1</updateEveryNMillis>
    <fileDir>https://rps-nccf-hfrnet-processed-prod.s3.us-east-1.amazonaws.com/waves/#STATION#/</fileDir>
    <fileNameRegex>.*.csv</fileNameRegex>
    <recursive>true</recursive>
    <pathRegex>.*</pathRegex>
    <metadataFrom>last</metadataFrom>
    <standardizeWhat>0</standardizeWhat>
    <charset>ISO-8859-1</charset>
    <columnSeparator>,</columnSeparator>
    <columnNamesRow>1</columnNamesRow>
    <firstDataRow>2</firstDataRow>
    <sortedColumnSourceName>TIME_SEC</sortedColumnSourceName>
    <sortFilesBySourceNames>TIME_SEC</sortFilesBySourceNames>
    <fileTableInMemory>false</fileTableInMemory>
    <accessibleViaFiles>false</accessibleViaFiles>
    <!-- sourceAttributes>
    </sourceAttributes -->
    <!-- Please specify the actual cdm_data_type (TimeSeries?) and related info below, for example...
        <att name="cdm_timeseries_variables">station_id, longitude, latitude</att>
        <att name="subsetVariables">station_id, longitude, latitude</att>
    -->
    <addAttributes>
        <att name="cdm_data_type">RadialSweep</att>
        <att name="Conventions">CF-1.12, ACDD-1.3, IOOS-1.2</att>
        <att name="infoUrl">https://rps-nccf-hfrnet-dissimentation-prod.s3.us-east-1.amazonaws.com/waves/#STATION#/</att>
        <att name="institution">#INSTITUTION#</att>
        <att name="keywords">acnt, aws, bigc, bucket, data, dist, flag, hfrnet, latitude, longitude, minimum, mthd, mwht, mwpd, nccf, pmwh, processed, quality, rcll,  str, swbd, swdp, swfb, swfl, swht, swpd, tday, temperature, thrs, time, time2, TMIN, tmon, tsec, tyrs, wavb, waves, wdpt, whnm, whsd, wndb, wwdp, wwfb, wwfl, wwht, wwpd</att>
        <att name="license">[standard]</att>
        <att name="sourceUrl">(local files)</att>
        <att name="standard_name_vocabulary">CF Standard Name Table v70</att>
        <att name="subsetVariables">file_type,DIST, longitude, latitude, WWFB, WWDP, WWFL, SWFB, SWDP, SWFL, SWBD, TYRS, TMON, TSEC</att>
        <att name="summary">waves/#STATION# data from AWS S3 bucket rps-nccf-hfrnet-processed-prod</att>
        <att name="testOutOfDate">now-1day</att>
        <att name="title">Wave data for #STATION#</att>
        <att name="publisher_email">data.ioos@noaa.gov</att>
        <att name="publisher_type">institution</att>
        <att name="publisher_institution">NOAA IOOS Surface Currents Program</att>
        <att name="publisher_name">NOAA IOOS Surface Currents Program</att>
        <att name="publisher_url">https://ioos.noaa.gov/project/hf-radar/</att>
        <att name="publisher_country">United States of America</att>
        <att name="creator_type">#CREATOR_TYPE#</att>
        <att name="creator_institution">#CREATOR_INST#</att>
        <att name="creator_name">#CREATOR_NAME#"</att>
        <att name="creator_email">#CREATOR_EMAIL#</att>
        <att name="creator_url">#CREATOR_URL#</att>
        <att name="creator_sector">#CREATOR_SECTOR#</att>
        <att name="creator_country">#CREATOR_COUNTRY#</att>
        <att name="platform_name">#PLATFORM_NAME#</att>
        <att name="platform_vocabulary">https://mmisw.org/ont/ioos/platform</att>

    </addAttributes>

       
    <dataVariable>
        <sourceName>TIME_SEC</sourceName>
        <destinationName>time</destinationName>
        <dataType>double</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="ioos_category">Time</att>
            <att name="coverage_content_type">coordinate</att>
            <att name="long_name">TIME SEC</att>
            <att name="source_name">TIME_SEC</att>
            <att name="standard_name">time</att>
            <att name="time_precision">1970-01-01T00:00:00Z</att>
            <att name="units">seconds since 1970-01-01T00:00:00Z</att>
        </addAttributes>
    </dataVariable>

    <dataVariable>
        <sourceName>***fileName,(.*)(_.*){6}\.csv,1</sourceName>
        <destinationName>file_type</destinationName>
        <dataType>String</dataType>

        <addAttributes>
          <att name="long_name">flag indicating type of processing used</att>
          <att name="ioos_category">Unknown</att>
          <att name="coverage_content_type">qualityInformation</att>
        </addAttributes>
      </dataVariable>   
 

    <dataVariable>
        <sourceName>MWHT</sourceName>
        <destinationName>MWHT</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="float">999.0</att>
            <att name="ioos_category">Unknown</att>
            <att name="units">m</att>
            <att name="standard_name">sea_surface_wave_significant_height</att>
            <att name="long_name">wave_model_height_in_meters</att>
            <att name="coverage_content_type">physicalMeasurement</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>MWPD</sourceName>
        <destinationName>MWPD</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="float">999.0</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wave_spectra_period</att>
            <att name="units">seconds</att>
            <att name="coverage_content_type">physicalMeasurement</att>
            <att name="standard_name">sea_surface_wave_mean_period</att>  
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WAVB</sourceName>
        <destinationName>WAVB</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wave_from_direction</att>
            <att name="units">degrees</att>
            <att name="standard_name">sea_surface_wave_from_direction</att>
            <att name="coverage_content_type">physicalMeasurement</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WNDB</sourceName>
        <destinationName>WNDB</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wind_from_direction</att>
            <att name="units">degrees</att>
            <att name="standard_name">wind_from_direction</att>
            <att name="coverage_content_type">physicalMeasurement</att> 
       </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>PMWH</sourceName>
        <destinationName>PMWH</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">predicted_wave_height_based_on_cross_spectra_noise_floor</att>
            <att name="units">m</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>ACNT</sourceName>
        <destinationName>ACNT</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">spectra_count</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>DIST</sourceName>
        <destinationName>DIST</destinationName>
        <dataType>double</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="double">NaN</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">distance_from_origin</att>
            <att name="units">km</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>RCLL</sourceName>
        <destinationName>RCLL</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">range_cell_of_result_from_cross_spectra</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>LOND</sourceName>
        <destinationName>longitude</destinationName>
        <dataType>double</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="colorBarMaximum" type="double">180.0</att>
            <att name="colorBarMinimum" type="double">-180.0</att>
            <att name="ioos_category">Location</att>
            <att name="long_name">longitude</att>
            <att name="source_name">LOND</att>
            <att name="standard_name">longitude</att>
            <att name="coverage_content_type">coordinate</att>
            <att name="units">degrees_east</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>LATD</sourceName>
        <destinationName>latitude</destinationName>
        <dataType>double</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="colorBarMaximum" type="double">90.0</att>
            <att name="colorBarMinimum" type="double">-90.0</att>
            <att name="ioos_category">Location</att>
            <att name="long_name">latitude</att>
            <att name="source_name">LATD</att>
            <att name="standard_name">latitude</att>
            <att name="units">degrees_north</att>
            <att name="coverage_content_type">coordinate</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WDPT</sourceName>
        <destinationName>WDPT</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">number_of_doppler_points_used_for_wave_calculation</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>MTHD</sourceName>
        <destinationName>MTHD</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wave_method</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>FLAG</sourceName>
        <destinationName>FLAG</destinationName>
        <dataType>short</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="short">32767</att>
            <att name="colorBarMaximum" type="double">150.0</att>
            <att name="colorBarMinimum" type="double">0.0</att>
            <att name="ioos_category">Quality</att>
            <att name="long_name">wave_vector_flag</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WHNM</sourceName>
        <destinationName>WHNM</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wave_height_valid_points</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WHSD</sourceName>
        <destinationName>WHSD</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wave_height_standard_deviation</att>
            <att name="units">m</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WWHT</sourceName>
        <destinationName>WWHT</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="float">999.0</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wind_wave_height</att>
            <att name="units">m</att>
            <att name="standard_name">sea_surface_wind_wave_significant_height</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WWPD</sourceName>
        <destinationName>WWPD</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="float">999.0</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wind_wave_period</att>
            <att name="units">seconds</att>
	    <att name="standard_name">sea_surface_wind_wave_mean_period</att>

        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WWFB</sourceName>
        <destinationName>WWFB</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
             <att name="ioos_category">Unknown</att>
             <att name="standard_name">sea_surface_wind_wave_from_direction</att>
             <att name="long_name">wind_wave_from_direction</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WWDP</sourceName>
        <destinationName>WWDP</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wind_wave_doppler_bins</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>WWFL</sourceName>
        <destinationName>WWFL</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">wind_wave_vector_flag</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>SWHT</sourceName>
        <destinationName>SWHT</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="float">999.0</att>
            <att name="ioos_category">Unknown</att>
            <att name="units">m</att>
            <att name="standard_name">sea_surface_swell_wave_significant_height</att>
            <att name="long_name">swell_wave_height</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>SWPD</sourceName>
        <destinationName>SWPD</destinationName>
        <dataType>float</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
        <addAttributes>
            <att name="_FillValue" type="float">999.0</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">swell_wave_period</att>
            <att name="standard_name">sea_surface_swell_wave_mean_period</att>
            <att name="units">seconds</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>SWFB</sourceName>
        <destinationName>SWFB</destinationName>
