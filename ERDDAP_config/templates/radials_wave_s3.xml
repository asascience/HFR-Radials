        <addAttributes>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">bimodal_boundary_period_between_swell_and_wind_waves</att>
            <att name="units">seconds</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
