            <att name="_FillValue" type="short">32767</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">year</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>TMON</sourceName>
        <destinationName>TMON</destinationName>
        <dataType>String</dataType>
