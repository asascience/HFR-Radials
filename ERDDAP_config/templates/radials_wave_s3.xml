            <att name="_FillValue" type="byte">127</att>
            <att name="ioos_category">Unknown</att>
            <att name="long_name">swell_wave_doppler_bins</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>SWFL</sourceName>
        <destinationName>SWFL</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
