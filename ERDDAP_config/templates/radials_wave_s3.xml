        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>SWDP</sourceName>
        <destinationName>SWDP</destinationName>
        <dataType>byte</dataType>
        <!-- sourceAttributes>
        </sourceAttributes -->
